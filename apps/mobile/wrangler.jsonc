{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ssakmail-mobile",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "m.ssakmail.com", "custom_domain": true }],
  "vars": {
    "NEXTAUTH_URL": "https://m.ssakmail.com"
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "PREFERENCES_DB",
      "database_name": "ssakmail-preferences",
      "database_id": "92e43031-f54b-4b2c-adfd-2f3955234e82",
      "migrations_dir": "../../database/migrations"
    }
  ],
  "vectorize": [
    {
      "binding": "PREFERENCE_VECTORS",
      "index_name": "ssakmail-preferences"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
