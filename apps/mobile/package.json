{
  "name": "@ssakmail/mobile",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "next build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "dev": "next dev --port 3001",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.2.0",
    "@ssakmail/auth": "workspace:*",
    "@ssakmail/data-access": "workspace:*",
    "@ssakmail/gmail": "workspace:*",
    "@ssakmail/preference": "workspace:*",
    "@ssakmail/ui": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "axios": "1.19.0",
    "next": "16.3.0",
    "next-auth": "4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "7.0.2",
    "wrangler": "4.118.0"
  }
}
