{
  "compilerOptions": {
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@ssakmail/auth": ["./packages/auth/src/index.ts"],
      "@ssakmail/data-access": ["./packages/data-access/src/index.tsx"],
      "@ssakmail/gmail": ["./packages/gmail/src/index.ts"],
      "@ssakmail/preference": ["./packages/preference/src/index.ts"],
      "@ssakmail/preference/cloudflare": [
        "./packages/preference/src/cloudflare.ts"
      ],
      "@ssakmail/ui": ["./packages/ui/src/index.tsx"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  }
}
